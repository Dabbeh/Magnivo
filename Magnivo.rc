#include <winver.h>

// Program icon (shows in Explorer, taskbar, Alt+Tab).
IDI_ICON1 ICON DISCARDABLE "assets/logo.ico"

// Application manifest: Per-Monitor V2 DPI awareness (required so the
// Magnification API gets physical-pixel coordinates) + Win10/11 support.
1 24 "Magnivo.exe.manifest"

// Version + name info (shows in Explorer right-click > Properties > Details).
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,1,1,0
PRODUCTVERSION 1,1,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Magnivo"
      VALUE "FileDescription", "Magnivo screen magnifier"
      VALUE "FileVersion", "1.1.1"
      VALUE "InternalName", "Magnivo"
      VALUE "OriginalFilename", "Magnivo.exe"
      VALUE "ProductName", "Magnivo"
      VALUE "ProductVersion", "1.1.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
